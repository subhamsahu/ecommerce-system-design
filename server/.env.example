# PostgreSQL is the primary local database for this project.
# When running the API directly on your host, use localhost.
DATABASE_URL=postgresql+psycopg2://ecommerce:ecommerce_dev_only@localhost:5432/ecommerce

# Set APP_ENV=production only with a unique 32+ character secret.
APP_ENV=development
SECRET_KEY=replace-me-in-local-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Docker Compose database settings.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_dev_only
POSTGRES_DB=ecommerce
